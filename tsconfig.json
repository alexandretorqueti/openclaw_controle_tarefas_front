{
  "compilerOptions": {
    /* Ambiente e Saída */
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    
    /* Módulos e Resolução */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true, // Permite fazer import de arquivos .json nativamente
    
    /* React */
    "jsx": "react-jsx",
    
    /* Interoperabilidade */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    
    /* Modo de Delegação (Build) */
    "noEmit": true,
    "isolatedModules": true,
    
    /* Checagem Rigorosa */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, // Pula a checagem de tipos dentro da pasta node_modules (acelera MUITO o editor)
    
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}